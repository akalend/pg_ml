CREATE TABLE public.titanic (
    id integer,
    passenger_id integer,
    pclass integer,
    name text,
    sex text,
    age double precision,
    sibsp integer,
    parch integer,
    ticket text,
    fare double precision,
    cabin text,
    embarked character(1),
    res boolean
);
COPY titanic FROM '/tmp/model/titanic.csv' HEADER CSV; 
SELECT * FROM titanic LIMIT 2;
 id | passenger_id | pclass |               name               |  sex   | age  | sibsp | parch | ticket |  fare  | cabin | embarked | res 
----+--------------+--------+----------------------------------+--------+------+-------+-------+--------+--------+-------+----------+-----
  0 |          892 |      3 | Kelly, Mr. James                 | male   | 34.5 |     0 |     0 | 330911 | 7.8292 | -999  | Q        | f
  1 |          893 |      3 | Wilkes, Mrs. James (Ellen Needs) | female |   47 |     1 |     0 | 363272 |      7 | -999  | S        | f
(2 rows)

CREATE TABLE public.rating_txt(
    id double precision,
    synopsis text,
    rating_mpaa text,
    genre text,
    director text,
    writer text,
    theater_date text,
    dvd_date text,
    box_office double precision,
    runtime double precision,
    studio text,
    dvd_date_int bigint,
    theater_date_int bigint,
    review text,
    rating double precision,
    fresh text,
    critic text,
    top_critic bigint,
    publisher text,
    date text,
    date_int double precision,
    rating_10 double precision
);
COPY rating_txt FROM '/tmp/model/rating_txt.csv' HEADER CSV; 
SELECT rating_10,critic,box_office FROM rating_txt LIMIT 4;
 rating_10 |    critic    | box_office 
-----------+--------------+------------
         8 | Carol Cling  |           
         6 |              |     116783
         6 | Jack Mathews |     598103
         9 | Greg Maki    |  177575142
(4 rows)

